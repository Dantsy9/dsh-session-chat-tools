{
  "name": "dsh-session-chat-tools",
  "version": "0.3.3",
  "description": "Session archive, cross-session read, message, wait, and copy-ID tools for DeepSeek Harness (maintained fork of dsh-session-tools)",
  "main": "lib/index.js",
  "scripts": {
    "test": "npm run build && node --test tests/*.mjs",
    "build": "node scripts/build-client.mjs"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "author": "Dantsy9",
  "contributors": [
    "Unintended (original dsh-session-tools: https://github.com/Unintendedz/dsh-session-tools)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dantsy9/dsh-session-chat-tools.git"
  },
  "homepage": "https://github.com/Dantsy9/dsh-session-chat-tools#readme",
  "bugs": {
    "url": "https://github.com/Dantsy9/dsh-session-chat-tools/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "dsh-plugin",
    "session-management",
    "conversation"
  ]
}
